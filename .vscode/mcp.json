{
  "servers": {
    "supply-chain-finops": {
      "type": "stdio",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["mcp_server.py"],
      "cwd": "${workspaceFolder}",
      "env": {
        "FINOPS_DATA_SOURCE": "local",
        "FINOPS_DATA_DIR": "${workspaceFolder}\\data\\supply-chain",
        "FINOPS_BUSINESS_SCOPE": "Supply Chain",
        "FINOPS_BUSINESS_SCOPE_COLUMN": "business_unit"
      }
    }
  }
}
