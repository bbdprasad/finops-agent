# Copy to .env, fill in, and never commit it. Add .env to .gitignore.
# Production: use a key vault and a service account, not a personal mailbox.

ANTHROPIC_API_KEY=sk-ant-...
FINOPS_NARRATE_MODEL=claude-sonnet-5

FINOPS_DATA_DIR=./data
FINOPS_OUT_DIR=./reports
FINOPS_CURRENCY=DKK

# Data source: local, blob, or databricks
FINOPS_DATA_SOURCE=local
FINOPS_SOURCE_LOOKBACK_YEARS=2
FINOPS_BUSINESS_SCOPE=Supply Chain
FINOPS_BUSINESS_SCOPE_COLUMN=business_unit

# Blob mode: use either a connection string or account URL with managed identity
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_URL=https://youraccount.blob.core.windows.net
AZURE_STORAGE_CONTAINER=finops-costs
AZURE_STORAGE_PREFIX=

# Databricks mode: use a service principal or workload identity in production
DATABRICKS_SERVER_HOSTNAME=your-workspace.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id
DATABRICKS_TOKEN=
DATABRICKS_VIEW=main.finops.supply_chain_costs

# Detection thresholds. Raise if the report is noisy, lower if it misses things.
FINOPS_Z_THRESHOLD=3.5
FINOPS_MIN_ANOMALY_COST=500
FINOPS_MIN_MONTHLY_IMPACT=5000
FINOPS_STEP_CHANGE_PCT=0.25
FINOPS_BASELINE_DAYS=28
FINOPS_RECENT_DAYS=7
FINOPS_TRAILING_LAG_DAYS=2
# Set to 0 to disable the stale-data guard for local or exploratory reports.
FINOPS_MAX_STALENESS_DAYS=0
FINOPS_TAG_COVERAGE_TARGET=0.95

# Email
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=finops-reports@example.com
SMTP_PASSWORD=
FINOPS_MAIL_FROM=finops-reports@example.com
FINOPS_MAIL_TO=you@example.com,manager@example.com
FINOPS_MAIL_SUBJECT_PREFIX=[FinOps]
